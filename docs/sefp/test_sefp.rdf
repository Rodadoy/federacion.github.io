    <dcat:dataset>
      <dcat:Dataset rdf:about="https://datos.gob.es/dataset/prueba">
        <dct:title xml:lang="es">Relación de puestos de trabajo (RPT) del Personal Funcionario y del Personal Laboral</dct:title>
        <dct:description xml:lang="es">Conjunto de datos que presenta información de los puestos de trabajo para Funcionarios y Personal Laboral. Se incorpora información adicional relacionada con la edad de los profesionales que ocupan o han ocupado los puestos de trabajo así como la información necesaria para calcular la permanencia media o el índice de rotación.</dct:description>
