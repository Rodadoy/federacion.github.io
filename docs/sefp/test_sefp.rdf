    <dcat:dataset>
      <dcat:Dataset rdf:about="https://datos.gob.es/dataset/prueba1">
        <dct:title xml:lang="es">Estadística del Personal al servicio de las Administraciones Públicas (EPSAP)</dct:title>
        <dct:description xml:lang="es">Conjunto de datos denominados Microdatos que contienen la información debidamente anonimizada y agrupada de las personas que están al Servicio de las Administraciones Públicas y que se usa, entre otras cuestiones, para elaboración de la EPSAP (Estadística del Personal al servicio de las Administraciones Públicas) y que se presenta semestralmente.</dct:description>
